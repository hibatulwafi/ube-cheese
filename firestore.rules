rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────
    // IDENTITAS
    // ─────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    // Sumber kebenaran hak admin: keberadaan dokumen `admins/{uid}`.
    // Dokumen itu hanya bisa dibuat lewat Console/Admin SDK, sehingga
    // seorang admin tidak bisa mengangkat dirinya sendiri dari browser.
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ─────────────────────────────────────────────
    // VALIDASI BENTUK DATA
    // ─────────────────────────────────────────────

    function isValidMenu(data) {
      return data.name is string
        && data.name.size() > 0
        && data.name.size() <= 100
        && data.price is number
        && data.price >= 0
        && data.price <= 100000000
        && data.description is string
        && data.description.size() <= 500
        && data.category is string
        && data.category.size() <= 50
        && data.is_available is bool
        && (!('image_url' in data) || data.image_url is string)
        && data.created_at is timestamp;
    }

    function isValidNewOrder(data) {
      return data.customer_name is string
        && data.customer_name.size() > 0
        && data.customer_name.size() <= 100
        && data.items is list
        && data.items.size() > 0
        && data.items.size() <= 50
        && data.total_price is number
        && data.total_price >= 0
        && data.total_price <= 100000000
        && data.status == 'pending_payment'
        && data.created_by is string
        && data.created_at is timestamp;
    }

    // Kasir hanya boleh menyentuh field `status` — bukan harga atau isi pesanan.
    function isStatusOnlyUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['pending_payment', 'paid', 'completed', 'cancelled'];
    }

    // ─────────────────────────────────────────────
    // DAFTAR ADMIN
    // ─────────────────────────────────────────────
    match /admins/{uid} {
      // Seseorang hanya boleh mengecek status dirinya sendiri,
      // bukan mengintip daftar admin lain.
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // ─────────────────────────────────────────────
    // UBI CHEESE POS
    // ─────────────────────────────────────────────
    match /ubi-cheese/{storeId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if false;

      // Etalase menu boleh dibaca siapa saja, tapi hanya admin yang mengubah.
      match /menus/{menuId} {
        allow read: if true;
        allow create, update: if isAdmin() && isValidMenu(request.resource.data);
        allow delete: if isAdmin();
      }

      match /orders/{orderId} {
        // Hanya kasir yang boleh melihat daftar pesanan.
        allow read: if isAdmin();

        // Pelanggan (sesi anonim) boleh memesan, tapi wajib memakai uid-nya
        // sendiri sehingga pesanan tidak bisa diatasnamakan orang lain.
        allow create: if isSignedIn()
          && isValidNewOrder(request.resource.data)
          && request.resource.data.created_by == request.auth.uid;

        allow update: if isAdmin() && isStatusOnlyUpdate();
        allow delete: if false;
      }
    }

    // ─────────────────────────────────────────────
    // LEADERBOARD
    // ─────────────────────────────────────────────
    match /leaderboard/{docId} {
      allow read: if true;

      allow create, update: if
        request.resource.data.name is string &&
        request.resource.data.score is number &&
        request.resource.data.score >= 0 &&
        request.resource.data.score <= 9999;

      allow delete: if false;
    }

    // ─────────────────────────────────────────────
    // REWARD (CONFIG HADIAH)
    // reward / hadiahA
    // ─────────────────────────────────────────────
    match /reward/{docId} {
      allow read, update: if true;
      allow create, delete: if false;
    }

    // ─────────────────────────────────────────────
    // REVIEWS
    // ─────────────────────────────────────────────
    match /reviews/{docId} {
      allow create: if
        request.resource.data.username is string &&
        request.resource.data.menu in ['Dimsum', 'Cilok'] &&
        request.resource.data.rating is number &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 10;

      allow read, update, delete: if false;
    }

    // ─────────────────────────────────────────────
    // REWARD LOGS
    // ─────────────────────────────────────────────
    match /reward_logs/{docId} {
      allow read: if true;

      allow create: if
        request.resource.data.username is string &&
        request.resource.data.menu in ['Dimsum', 'Cilok'] &&
        request.resource.data.reward is string &&
        request.resource.data.status in ['win', 'lose'];

      allow update, delete: if false;
    }
  }
}
